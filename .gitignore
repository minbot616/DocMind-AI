# Python Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# Logs
*.log
docmind_ai.log
docmind_backend.log

# Generated Databases (SQLite & local test databases)
database/*.db
backend/database/*.db
tests/*.db

# Uploaded Documents & Vector Storage (Preserves directory structure)
documents/*
!documents/.gitkeep
vectors/*
!vectors/.gitkeep

# Evaluation Results
evaluation/results/*
!evaluation/results/.gitkeep

# IDE Configuration
.vscode/
.idea/
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db